  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@target/*": ["./src/*"], "vue": ["./node_modules/vue"] }
